# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ca_tax_os
APP_URL=http://localhost:3000
 
# Sessions
SESSION_COOKIE_NAME=catax_session
# SESSION_COOKIE_DOMAIN=
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60
CSRF_COOKIE_NAME=catax_csrf
 
# Request security
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
TRUST_PROXY=false
 
# Email: console | filesystem | smtp (smtp requires a real transport, see docs)
EMAIL_PROVIDER=filesystem
EMAIL_FROM=no-reply@catax.local
EMAIL_OUTBOX_DIR=.mail
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
 
# CA (ICAI) verification: mock | manual. No live ICAI integration exists yet.
CA_VERIFICATION_PROVIDER=mock
 
# Local bootstrap reviewer/admin account created by `npm run db:seed`
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@catax.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=Adm1n!Local#2026
 
# Returns verification/reset tokens in API responses. Development only.
EXPOSE_DEV_TOKENS=true