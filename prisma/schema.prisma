generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  LOCKED
}
 
enum AccountType {
  CA
  STAFF
  CLIENT
}
 
enum OnboardingState {
  NOT_STARTED
  ACCOUNT_CREATED
  EMAIL_VERIFIED
  ACCOUNT_TYPE_SELECTED
  CA_DETAILS_PENDING
  FIRM_DETAILS_PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}
 
enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEEDS_MORE_INFORMATION
}
 
enum PlatformRole {
  PLATFORM_ADMIN
  VERIFICATION_REVIEWER
}
 
enum FirmRole {
  FIRM_ADMIN
  PARTNER_CA
  STAFF
  CLIENT
}
 
enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}
 
enum FirmStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
 
enum ActorType {
  USER
  PLATFORM
  SYSTEM
}
 
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
 
model User {
  id                  String     @id @default(uuid())
  email               String
  normalizedEmail     String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phoneNumber         String?
  phoneVerifiedAt     DateTime?
  emailVerifiedAt     DateTime?
  status              UserStatus @default(PENDING_EMAIL_VERIFICATION)
  platformRole        PlatformRole?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
 
  sessions      Session[]
  tokens        VerificationToken[]
  caProfile     CAProfile?
  application   OnboardingApplication?
  memberships   FirmMembership[]
  auditLogs     AuditLog[]           @relation("AuditActor")
  reviewed      OnboardingApplication[] @relation("ApplicationReviewer")
  sentInvites   FirmInvitation[]     @relation("InvitationInviter")
 
  @@index([status])
}
 
model Session {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@index([userId])
  @@index([expiresAt])
}
 
model VerificationToken {
  id        String       @id @default(uuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime     @default(now())
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@index([userId, purpose])
}
 
model Firm {
  id                 String             @id @default(uuid())
  name               String
  type               String
  addressLine        String?
  city               String?
  state              String?
  country            String             @default("IN")
  contactEmail       String
  contactPhone       String?
  registrationNumber String?
  verificationStatus VerificationStatus @default(PENDING)
  status             FirmStatus         @default(PENDING)
  reviewerNotes      String?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
 
  memberships  FirmMembership[]
  invitations  FirmInvitation[]
  applications OnboardingApplication[]
  auditLogs    AuditLog[]
 
  @@index([verificationStatus])
  @@index([status])
}
 
model FirmMembership {
  id        String           @id @default(uuid())
  firmId    String
  userId    String
  role      FirmRole
  status    MembershipStatus @default(ACTIVE)
  invitedBy String?
  joinedAt  DateTime?
  removedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
 
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([firmId, userId])
  @@index([userId, status])
  @@index([firmId, status])
}
 
model CAProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  icaiMembershipNumber String
  copStatus            String?
  professionalName     String
  practiceName         String?
  verificationStatus   VerificationStatus @default(PENDING)
  supportingReference  String?
  providerReference    String?
  reviewerNotes        String?
  verifiedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
 
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications OnboardingApplication[]
 
  @@unique([icaiMembershipNumber])
  @@index([verificationStatus])
}
 
model FirmInvitation {
  id          String    @id @default(uuid())
  firmId      String
  invitedEmail String
  invitedRole FirmRole
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
 
  firm      Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id])
 
  @@index([firmId])
  @@index([invitedEmail])
}
 
model OnboardingApplication {
  id              String          @id @default(uuid())
  userId          String          @unique
  accountType     AccountType?
  caProfileId     String?
  firmId          String?
  state           OnboardingState @default(NOT_STARTED)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  reviewerNotes   String?
  infoRequested   String?
  version         Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
 
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  caProfile  CAProfile? @relation(fields: [caProfileId], references: [id])
  firm       Firm?      @relation(fields: [firmId], references: [id])
  reviewedBy User?      @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
 
  @@index([state])
  @@index([submittedAt])
}
 
model AuditLog {
  id           String    @id @default(uuid())
  actorUserId  String?
  actorType    ActorType @default(USER)
  action       String
  resourceType String
  resourceId   String?
  firmId       String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
 
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  firm  Firm? @relation(fields: [firmId], references: [id], onDelete: SetNull)
 
  @@index([firmId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}
 
model RateLimitCounter {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime
 
  @@index([windowEnd])
}
 
model IdempotencyKey {
  id        String   @id @default(uuid())
  userId    String?
  scope     String
  key       String
  createdAt DateTime @default(now())
 
  @@unique([scope, key])
}